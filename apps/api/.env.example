# ── Servidor ─────────────────────────────────────────────────────────────────
# Puertos propios de BackOffice: no chocan con MobilityManager (api 3000, web 5173)
# si ambas apps corren en la misma maquina.
PORT=3010
NODE_ENV=development
CORS_ORIGIN=http://localhost:5183

# ── Base de datos (Prisma / SQL Server) ──────────────────────────────────────
# BackOffice comparte la base Mobility_QATEST con MobilityManager. NO la posee.
# Prisma se usa SOLO como cliente — prohibido prisma migrate / db push.
# Los cambios de esquema van por scripts en prisma/sql/ aplicados a mano.
DATABASE_URL="sqlserver://100.66.245.49:1433;database=Mobility_QATEST;user=sa;password=CHANGE_ME;encrypt=false;trustServerCertificate=true"

# ── ITManager (ManageIT) — autoridad de identidad y ROL ──────────────────────
# El rol lo decide ITManager (rol asignado en la app). No se deriva del email ni de SAP.
# Sin rol asignado, el login devuelve 403.
ITMANAGER_AUTH_URL=http://100.66.245.49:61100/api
APP_ID=MobilityBackOffice
PERM_PREFIX=MOBILITYBO_

# ── Token propio de BackOffice ───────────────────────────────────────────────
# BackOffice EMITE SU PROPIO JWT (HS256) con el rol de la app adentro, en vez de
# reusar el de ManageIT. Motivo: el token de ManageIT no incluye los roleKeys, y
# sin ellos la autorizacion se degrada a `isAdmin`, que es global y lo activa
# cualquier *_SUPERADMIN de CUALQUIER aplicacion. Ver docs/AUTENTICACION.md.
#
# Secret PROPIO: NO reutilizar el de ManageIT, o un token de otra app validaria aca.
# Minimo 16 caracteres. Generar con: openssl rand -base64 48
BACKOFFICE_JWT_SECRET=CHANGE_ME_secret_propio_de_backoffice
# Vigencia del token. El rol queda congelado hasta que expira: si se le cambia el
# rol a alguien en ITManager, el cambio aplica en su proximo login.
JWT_EXPIRES_IN=1h

# ── Regiones comerciales ─────────────────────────────────────────────────────
# Key del web service de sync máquina-a-máquina (header x-api-key).
# Vacía o ausente = el endpoint POST /api/regions/sync queda deshabilitado (403).
REGIONS_SYNC_API_KEY=

# ── DuwyEngineRAG (cargador de documentacion embebido) ───────────────────────
# Base URL del RAG. Se embebe via reverse-proxy same-origin en /rag (el RAG manda
# X-Frame-Options: SAMEORIGIN, no se puede iframe directo). Sin esta variable, el
# proxy no se monta y la seccion "Documentacion del RAG" no carga.
RAG_URL=http://100.89.65.72:3800
